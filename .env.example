# Plantilla de configuración privada.
# Copie este archivo a ".env" y complete los valores:
#     cp .env.example .env
# Nunca publique ".env" ni lo incluya en el repositorio.

# ---------------------------------------------------------------------------
# API opcional para organizar hallazgos
# ---------------------------------------------------------------------------
# Clave privada del proveedor. Si la deja vacía, la aplicación opera en
# modo "citas literales locales" (sin síntesis asistida por IA).
LLM_API_KEY=AQ.Ab8RN6Lt6tN8IA_VS0PoRH1u_bJsUlcEedzPSb1VO8wRBfWs8A

# Endpoint compatible con la API de OpenAI. Ajústelo si su proveedor usa
# otro URL o si prefiere un proxy local.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Modelo a utilizar. El MVP está pensado para modelos pequeños y rápidos;
# ajústelo a las recomendaciones oficiales de su proveedor.
LLM_MODEL=gemini-2.5-flash
